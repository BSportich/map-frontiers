<launch>
  <arg name="sub_sample_size" default="10" />
  <arg name="namespace" default="" />
  <arg name="timer" default="false" />
  <arg name="verbose" default="false" />
  <arg name="extra_viz" default="false" />

  <group ns="$(arg namespace)">
    <node name="drone_NBV_selector" pkg="map_frontiers" type="NBV_Selector" output="screen">
        <remap from="esdf_map_out" to="/voxblox_node/esdf_map_out" />
        <remap from="tsdf_map_out" to="/voxblox_node/tsdf_map_out" />

        <remap from="pos_goal" to="/$(arg namespace)/next_best_viewpoint" />
        <remap from="groundtruth/odom" to="/$(arg namespace)/groundtruth/odom" />
        <remap from="is_idle" to="/$(arg namespace)/mav_local_planner/is_idle" />

        <param name="voxel_size" command="rosparam get /voxel_size" />
        <param name="voxels_per_side" command="rosparam get /voxels_per_side" />
        
        <param name="sub_sample_size" value="$(arg sub_sample_size)" />

        <param name="timer" value="$(arg timer)" />
        <param name="verbose" value="$(arg verbose)" />
        <param name="extra_viz" value="$(arg extra_viz)" />
    </node>
  </group>
</launch>
